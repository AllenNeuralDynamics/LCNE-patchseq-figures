{
	"version": 1,
	"base_image": "codeocean/mambaforge3:24.5.0-0-python3.12.4-ubuntu22.04",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "h5py",
					"version": "3.16.0"
				},
				{
					"name": "matplotlib",
					"version": "3.10.9"
				},
				{
					"name": "numpy",
					"version": "2.2.6"
				},
				{
					"name": "pandas",
					"version": "2.3.3"
				},
				{
					"name": "scipy",
					"version": "1.15.3"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
}